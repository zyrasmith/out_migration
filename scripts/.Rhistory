mutate(
variable_label = if_else(
is.na(category),
variable,
paste0(variable, " = ", category)
),
stat = if_else(
is.na(sd),
sprintf("%.2f", mean),
sprintf("%.2f (%.2f)", mean, sd)
)
) %>%
select(variable, variable_label, mean, sd, stat)
desc_table
library(dplyr)
library(purrr)
library(tibble)
library(tidyr)
# Define variable groups
inst_vars <- c(Y, Z)
cbsa_vars <- Zh
# Treat these variables as continuous
continuous_vars <- c(
"i_perc_white", "i_perc_black", "i_perc_hisp", "i_perc_asian",
"inst_num", "tot_pop", "pop_density", "perc_ba", "med_income",
"perc_pov", "perc_unemployed", "perc_white", "perc_black",
"perc_hisp", "perc_asian"
)
# Keep the final analytic sample used for descriptive statistics
analytic_data <- data_mlca %>%
drop_na(all_of(c(inst_vars, cbsa_vars)))
# Create CBSA-level data with one row per CBSA
cbsa_data <- analytic_data %>%
distinct(cbsa, .keep_all = TRUE)
# Count sample sizes
n_institutions <- analytic_data %>%
summarise(n = n_distinct(unitid)) %>%
pull(n)
n_cbsas <- cbsa_data %>%
summarise(n = n_distinct(cbsa)) %>%
pull(n)
# Function to calculate descriptive statistics
make_desc_table <- function(data, vars) {
map_dfr(vars, function(v) {
x <- data[[v]]
x_nonmiss <- x[!is.na(x)]
n_cat <- dplyr::n_distinct(x_nonmiss)
if (v %in% continuous_vars) {
# For continuous variables, report mean and standard deviation
tibble(
variable = v,
category = NA_character_,
mean = round(mean(x_nonmiss, na.rm = TRUE), 2),
sd = round(sd(x_nonmiss, na.rm = TRUE), 2)
)
} else if (n_cat == 2) {
# For binary variables, report only the mean
tibble(
variable = v,
category = NA_character_,
mean = round(mean(x_nonmiss, na.rm = TRUE), 2),
sd = NA_real_
)
} else {
# For categorical variables with 3 or more categories,
# report the proportion for each category
cats <- sort(unique(x_nonmiss))
tibble(
variable = v,
category = as.character(cats),
mean = map_dbl(cats, ~ round(mean(as.character(x_nonmiss) == as.character(.x)), 2)),
sd = NA_real_
)
}
}) %>%
mutate(
variable_label = if_else(
is.na(category),
variable,
paste0(variable, " = ", category)
),
stat = if_else(
is.na(sd),
sprintf("%.2f", mean),
sprintf("%.2f (%.2f)", mean, sd)
)
) %>%
select(variable, variable_label, mean, sd, stat)
}
# Institution-level descriptive statistics
desc_inst <- make_desc_table(analytic_data, inst_vars)
# CBSA-level descriptive statistics
desc_cbsa <- make_desc_table(cbsa_data, cbsa_vars)
inst_table_final <- bind_rows(
tibble(
variable = NA_character_,
variable_label = paste0("Institutions (n = ", n_institutions, ")"),
mean = NA_real_,
sd = NA_real_,
stat = NA_character_
),
desc_inst
) %>%
select(Variable = variable_label, Statistic = stat)
inst_table_final
cbsa_table_final <- bind_rows(
tibble(
variable = NA_character_,
variable_label = paste0("Core-based statistical areas (n = ", n_cbsas, ")"),
mean = NA_real_,
sd = NA_real_,
stat = NA_character_
),
desc_cbsa
) %>%
select(Variable = variable_label, Statistic = stat)
cbsa_table_final
lc_l2 <- multiLCA(
data = data_mlca,
Y              = Y,
iT             = 6:12,
Z              = Z,
iM             = 2:5,
id_high        = c("cbsa_id"),
Zh             = Zh,
incomplete     = FALSE,
extout         = TRUE,
verbose        = TRUE,
sequential     = TRUE,
reord          = FALSE
)
lc_l2
summary(lc_l2)
plot(lc_l2)
