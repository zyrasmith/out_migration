cbsa_types <- aggregate(z, by = list(cluster = cbsa_clusters), FUN = mean)
cbsa_types
cbsa_clusters <- y |>
mutate(cbsa_cluster = as.factor(cbsa_clusters))
final_data <- cbsa_clusters |>
select(cbsa, cbsa_cluster, n) |>
rename(total_inst = n) |>
left_join(analytic2 |>
select(unitid, instnm, stabbr, cbsa, cluster) |>
rename(inst_class = cluster),
by = "cbsa") |>
relocate(unitid, instnm, inst_class, stabbr, cbsa, cbsa_cluster, total_inst)
# Class 1 Label: HBCUs and 4-year HSIs
# Class 2 Label: Large graduate degree-granting institutions
# Class 3 Label: Public two-years and low-tuition 4-year colleges
# Class 4 Label: Graduate degree-focused institutions
# Class 5 Label: Medical/health sciences, two-year and private 4-year
# Class 6 Label: Bachelor's degree, special focus colleges (professions/arts & sciences)
# Class 7 Label: Two-year, Special focus(Applied and career studies)
# Class 8 Label: Private, four-year, doctoral degree, high STEM-focus
# Class 9 Label: Tribal colleges
#Describe CBSA clusters
# 1: Common college types: 1,3,2,4,6,8         Missing types: 5,7,9          Mean number of colleges: 2.4    Label: HBCUs and broad-access HSI-dominant
# 2: Common college types: 3,4,2,8,6,1,5,7,9   Missing types: --             Mean number of colleges: 17.0   Label: 2-year, grad degree-focused, many four-year colleges
# 3: Common college types: 7,6,5,3,2,8,1,4,9   Missing types: --
# 4: Common college types: 3,2,1,8,9           Missing types: 4,5,6,7
# 5: Common college types: 2,8,5               Missing types: 1,3,4,6,7,9
# 6: Common college types: 6,3,8,9,4,1         Missing types: 2,5,7
# 7: Common college types: 4,3,2,6,8,7,5,9,1   Missing types: --
# 8: Common college types: 8,3,6,2             Missing types: 1,4,5,7,9
# Table 4. Distribution of Institutional Clusters Across CBSA Clusters
d <- final_data |>
transmute(
cbsa,
CBSA_Cluster = as.integer(as.character(cbsa_cluster)),
Inst_Cluster = as.integer(as.character(inst_class))
)
# Number of CBSAs and institutions
sizes <- d |>
group_by(CBSA_Cluster) |>
summarise(
`CBSAs (n)` = n_distinct(cbsa),
`Institutions (n)` = n(),
.groups = "drop"
)
# Institutional cluster percentages
distribution <- d |>
count(CBSA_Cluster, Inst_Cluster) |>
complete(CBSA_Cluster = 1:8,
Inst_Cluster = 1:9,
fill = list(n = 0)) |>
group_by(CBSA_Cluster) |>
mutate(Percent = round(100 * n / sum(n), 1)) |>
ungroup() |>
select(-n) |>
pivot_wider(
names_from = Inst_Cluster,
values_from = Percent,
names_glue = "Inst. {Inst_Cluster} (%)"
)
# Table 4
table4 <- sizes |>
right_join(distribution, by = "CBSA_Cluster") |>
arrange(CBSA_Cluster)
print(table4, width = Inf)
write_xlsx(table4, "../data/HCA_cluster_distribution.xlsx")
# Table 6. CBSA Characteristics by Cluster
# CBSA-level data
d6 <- cbsa_clusters |>
distinct(cbsa, .keep_all = TRUE) |>
select(cbsa, cbsa_cluster, cbsatype, n) |>
rename(total_inst = n) |>
left_join(census, by = c("cbsa" = "GEOID")) |>
mutate(
cbsa_cluster = factor(as.character(cbsa_cluster),
levels = as.character(1:8)),
cbsatype = factor(as.character(cbsatype), c("0", "1"),
c("Micropolitan", "Metropolitan"))
)
# Variables in Table 1 order
vars <- c(
"cbsatype", "total_inst", "tot_pop", "pop_density",
"perc_ba", "med_income", "perc_pov", "perc_unemployed",
"perc_white", "perc_black", "perc_hisp", "perc_asian"
)
# Variable labels
labels <- c(
cbsatype = "CBSA Type",
total_inst = "Number of Institutions in the Analytic Sample",
tot_pop = "Total Population (100,000s)",
pop_density = "Population Density (Persons per Square Mile)",
perc_ba = "Population Aged 25+ with a Bachelor's Degree or Higher (%)",
med_income = "Median Household Income ($)",
perc_pov = "Families Below the Poverty Level (%)",
perc_unemployed = "Unemployment Rate (%)",
perc_white = "Non-Hispanic White Population (%)",
perc_black = "Non-Hispanic Black Population (%)",
perc_hisp = "Hispanic or Latino Population (%)",
perc_asian = "Non-Hispanic Asian Population (%)"
)
# Descriptive statistics by cluster
profiles <- purrr::map_dfr(vars, function(v) {
if (v == "cbsatype") {
d6 |>
count(cbsa_cluster, Category = cbsatype, .drop = FALSE) |>
group_by(cbsa_cluster) |>
mutate(
Variable = paste(labels[[v]], Category, sep = ": "),
Value = sprintf("%.2f", n / sum(n))
) |>
ungroup() |>
select(Variable, cbsa_cluster, Value)
} else {
d6 |>
group_by(cbsa_cluster) |>
summarise(
Value = sprintf("%.2f (%.2f)",
mean(.data[[v]], na.rm = TRUE),
sd(.data[[v]], na.rm = TRUE)),
.groups = "drop"
) |>
mutate(Variable = labels[[v]]) |>
select(Variable, cbsa_cluster, Value)
}
})
# Cluster sizes
sizes <- d6 |>
count(cbsa_cluster) |>
transmute(
Variable = "CBSAs (n)",
cbsa_cluster,
Value = as.character(n)
)
# Table 6
table6 <- bind_rows(sizes, profiles) |>
pivot_wider(
names_from = cbsa_cluster,
values_from = Value,
names_prefix = "Cluster "
)
print(table6, n = Inf, width = Inf)
write_xlsx(table6, "../data/HCA_CBSA_profiles.xlsx")
# Level 1: Institutions
l1 <- data |>
semi_join(final_data, by = "unitid") |>
mutate(
inst_type = factor(inst_type, 0:3,
c("Public 2-year", "Private 2-year",
"Public 4-year", "Private 4-year")),
system = factor(system, 0:1,
c("Not in system", "In system")),
awardlev = factor(awardlev, 0:3,
c("Associate", "Baccalaureate", "Master's", "Doctoral")),
special_focus = factor(special_focus, 0:6,
c("Not special focus", "Professions-focused",
"Applied and career studies", "Arts and sciences",
"Business", "Medical/health sciences", "STEM")),
msi = factor(msi, 0:3,
c("None", "HBCU", "HSI", "TCU")),
evening = factor(evening, 0:1, c("No", "Yes"))
)
# Level 2: CBSAs
l2 <- final_data |>
distinct(cbsa, total_inst) |>
left_join(data |> distinct(cbsa, cbsatype), by = "cbsa") |>
left_join(census, by = c("cbsa" = "GEOID")) |>
mutate(cbsatype = factor(cbsatype, 0:1,
c("Micropolitan", "Metropolitan")))
# Variables
l1_vars <- c("inst_type", "system", "awardlev", "special_focus",
"num_degrees", "online_progs", "evening",
"instruction_exp_fte", "tuitionnn", "msi",
"adult", "pell", "nonwhite", "i_total_pop",
"per_undergrad", "selectivity")
l2_vars <- c("cbsatype", "total_inst", "tot_pop", "pop_density",
"perc_ba", "med_income", "perc_pov", "perc_unemployed",
"perc_white", "perc_black", "perc_hisp", "perc_asian")
l1_cat <- c("inst_type", "system", "awardlev",
"special_focus", "evening", "msi")
l2_cat <- "cbsatype"
# Descriptive statistics function
desc <- function(df, vars, cats) {
map_dfr(vars, function(v) {
if (v %in% cats) {
tibble(Category = df[[v]]) |>
filter(!is.na(Category)) |>
count(Category) |>
mutate(
Variable = paste(v, Category, sep = ": "),
`Mean (SD)` = sprintf("%.2f", n / sum(n))
) |>
select(Variable, `Mean (SD)`)
} else {
tibble(
Variable = v,
`Mean (SD)` = sprintf("%.2f (%.2f)",
mean(df[[v]], na.rm = TRUE),
sd(df[[v]], na.rm = TRUE))
)
}
})
}
# Table 1
table1 <- bind_rows(
tibble(Variable = paste0("Level 1: Institutions (N = ", nrow(l1), ")"),
`Mean (SD)` = ""),
desc(l1, l1_vars, l1_cat),
tibble(Variable = paste0("Level 2: CBSAs (N = ", nrow(l2), ")"),
`Mean (SD)` = ""),
desc(l2, l2_vars, l2_cat)
)
# Display and export
print(table1, n = Inf)
write_xlsx(table1, "../data/HCA_descriptive_statistics.xlsx")
# Predictors
predictors <- c("tot_pop", "pop_density", "perc_ba",
"med_income", "perc_pov", "perc_unemployed",
"perc_black", "perc_hisp", "perc_asian")
# Regression data (Cluster 1 = reference)
reg_data <- d6 |>
select(cbsa_cluster, all_of(predictors)) |>
drop_na() |>
mutate(
cbsa_cluster = relevel(
factor(as.character(cbsa_cluster)), ref = "1"),
across(all_of(predictors), ~as.numeric(scale(.x)))
)
# Regression
reg_model <- nnet::multinom(
cbsa_cluster ~ .,
data = reg_data,
trace = FALSE,
Hess = TRUE,
maxit = 1000
)
if (reg_model$convergence != 0)
stop("Model did not converge.")
s <- summary(reg_model)
b <- s$coefficients
se <- s$standard.errors
# Variable labels
labels <- c(
tot_pop = "Total Population",
pop_density = "Population Density",
perc_ba = "Bachelor's Degree or Higher",
med_income = "Median Household Income",
perc_pov = "Poverty Rate",
perc_unemployed = "Unemployment Rate",
perc_black = "Non-Hispanic Black",
perc_hisp = "Hispanic or Latino",
perc_asian = "Non-Hispanic Asian",
"(Intercept)" = "Intercept"
)
# Regression results
results <- tibble(
Cluster = rep(rownames(b), each = ncol(b)),
Variable = rep(colnames(b), times = nrow(b)),
B = as.vector(t(b)),
SE = as.vector(t(se))
) |>
mutate(
p = 2 * pnorm(-abs(B / SE)),
`Est.` = paste0(
sprintf("%.3f", B),
case_when(
p < .001 ~ "***",
p < .01  ~ "**",
p < .05  ~ "*",
TRUE ~ ""
)
),
`S.E.` = sprintf("%.3f", SE),
Variable = factor(Variable,
levels = c(predictors, "(Intercept)")),
Cluster = factor(Cluster, levels = as.character(2:8))
) |>
arrange(Variable, Cluster)
# Wide format: Variables as rows, Clusters as columns
column_order <- unlist(lapply(2:8, function(k)
paste0("Cluster ", k, c(" Est.", " S.E."))
))
table7 <- results |>
select(Variable, Cluster, `Est.`, `S.E.`) |>
pivot_wider(
names_from = Cluster,
values_from = c(`Est.`, `S.E.`),
names_glue = "Cluster {Cluster} {.value}"
) |>
select(Variable, all_of(column_order)) |>
mutate(Variable = unname(labels[as.character(Variable)]))
# Full results: OR, CI, and p-values
full_results <- results |>
transmute(
Cluster = paste0("Cluster ", Cluster, " vs. Cluster 1"),
Predictor = unname(labels[as.character(Variable)]),
B = round(B, 3),
SE = round(SE, 3),
OR = round(exp(B), 3),
`95% CI` = sprintf("[%.3f, %.3f]",
exp(B - 1.96 * SE),
exp(B + 1.96 * SE)),
p = if_else(p < .001, "< .001", sprintf("%.3f", p))
)
# Model information
model_info <- tibble(
N = nrow(reg_data),
Reference = "Cluster 1",
AIC = round(AIC(reg_model), 2),
Converged = reg_model$convergence == 0
)
print(table7, width = Inf)
print(model_info)
# Export
write_xlsx(
list(
"Table 7" = table7,
"Full Results" = full_results,
"Model Information" = model_info
),
"../data/HCA_multinomial_regression.xlsx"
)
# 1. State boundaries: 50 States + DC (exclude Puerto Rico)
us_states <- tigris::states(
cb = TRUE, year = 2024, resolution = "20m"
) |>
filter(STUSPS %in% c(state.abb, "DC"))
# 2. CBSA cluster assignments
cluster_key <- cbsa_clusters |>
transmute(
GEOID = as.character(cbsa),
cluster = paste("Cluster", cbsa_cluster)
) |>
distinct(GEOID, .keep_all = TRUE)
# 3. CBSA boundaries and cluster data
cbsa_map <- land_area |>
sf::st_filter(
sf::st_transform(us_states, sf::st_crs(land_area))
) |>
mutate(GEOID = as.character(GEOID)) |>
left_join(cluster_key, by = "GEOID") |>
mutate(
cluster = replace_na(cluster, "Not in sample"),
cluster = factor(cluster,
levels = c(paste("Cluster", 1:8), "Not in sample"))
) |>
tigris::shift_geometry()
# 4. Shift Alaska and Hawaii
us_states <- us_states |>
tigris::shift_geometry()
# Figure 1. CBSA boundaries
map1 <- ggplot() +
geom_sf(data = us_states, fill = "white",
color = NA) +
geom_sf(data = cbsa_map, fill = NA,
color = "grey65", linewidth = 0.15) +
geom_sf(data = us_states, fill = NA,
color = "grey30", linewidth = 0.3) +
coord_sf(datum = NA) +
labs(title = "U.S. Core-Based Statistical Areas") +
theme_void(base_size = 12) +
theme(
plot.title = element_text(hjust = 0.5, face = "bold")
)
# Figure 2. CBSA clusters
library(khroma)
# num_colors <- length(unique(cbsa_map$cluster))
cluster_colors <-  c(
"Cluster 1" = "#CC6677",
"Cluster 2" = "#332288",
"Cluster 3" = "#DDCC77",
"Cluster 4" = "#117733",
"Cluster 5" = "#88CCEE",
"Cluster 6" = "#AA4499",
"Cluster 7" = "#D18054",
"Cluster 8" = "#999933",
"Not in sample" = "#DDDDDD"
)
#   "Cluster 1" = "#274C77",
#   "Cluster 2" = "#32658A",
#   "Cluster 3" = "#4682B4",
#   "Cluster 4" = "#80B4D2",
#   "Cluster 5" = "#B8D6E8",
#   "Cluster 6" = "#354D63",
#   "Cluster 7" = "#64748B",
#   "Cluster 8" = "#B5C5D0",
#   "Not in sample" = "#E8E8E8"
# )
map2 <- ggplot() +
geom_sf(data = us_states, fill = "white",
color = NA) +
geom_sf(data = cbsa_map, aes(fill = cluster),
color = "white", linewidth = 0.1) +
geom_sf(data = us_states, fill = NA,
color = "grey30", linewidth = 0.3) +
scale_fill_manual(
values = cluster_colors,
drop = FALSE,
name = "CBSA Cluster",
guide = guide_legend(nrow = 2, byrow = TRUE)
) +
coord_sf(datum = NA) +
labs(title = "Distribution of CBSA Clusters") +
theme_void(base_size = 12) +
theme(
plot.title = element_text(hjust = 0.5, face = "bold"),
legend.position = "bottom"
)
# Compact combined map using facets
panels <- c("(a) CBSA Boundaries", "(b) CBSA Clusters")
states_both <- bind_rows(
us_states |> mutate(Panel = panels[1]),
us_states |> mutate(Panel = panels[2])
)
cbsa_outline <- cbsa_map |>
mutate(Panel = panels[1])
cbsa_filled <- cbsa_map |>
mutate(Panel = panels[2])
combined_map <- ggplot() +
geom_sf(data = states_both,
fill = "white", color = NA) +
geom_sf(data = cbsa_outline,
fill = NA, color = "grey65",
linewidth = 0.15) +
geom_sf(data = cbsa_filled,
aes(fill = cluster),
color = "white", linewidth = 0.08) +
geom_sf(data = states_both,
fill = NA, color = "grey30",
linewidth = 0.25) +
scale_fill_manual(
values = cluster_colors,
drop = FALSE,
name = NULL
) +
facet_wrap(~Panel, nrow = 1) +
coord_sf(datum = NA, expand = FALSE) +
guides(fill = guide_legend(nrow = 2, byrow = TRUE)) +
theme_void(base_size = 12) +
theme(
strip.text = element_text(
size = 12, face = "bold",
margin = margin(b = 6)
),
strip.background = element_blank(),
panel.spacing.x = grid::unit(3, "mm"),
legend.position = "bottom",
legend.justification = "center",
legend.text = element_text(size = 9),
legend.key.size = grid::unit(0.3, "cm"),
legend.key.spacing.x = grid::unit(5, "pt"),
legend.box.spacing = grid::unit(6, "pt"),
plot.margin = margin(0, 0, 0, 0)
)
# Remove automatic legend
map_panels <- combined_map +
guides(fill = "none") +
theme(legend.position = "none")
# Custom legend with evenly spaced color boxes
legend_df <- tibble(
cluster = names(cluster_colors),
x = c(1, 3.2, 5.4, 7.6, 9.8,
2.1, 4.3, 6.5, 8.7),
y = c(rep(1.8, 5), rep(1.2, 4))
)
legend_plot <- ggplot(legend_df) +
geom_rect(
aes(
xmin = x - 0.18, xmax = x + 0.05,
ymin = y - 0.16, ymax = y + 0.16,
fill = cluster
),
color = NA
) +
geom_text(
aes(x = x + 0.23, y = y, label = cluster),
hjust = 0, size = 3.4
) +
scale_fill_manual(
values = cluster_colors,
guide = "none"
) +
coord_cartesian(
xlim = c(0.5, 11.5),
ylim = c(0.5, 2.5),
expand = FALSE
) +
theme_void() +
theme(
plot.background = element_rect(
fill = "white", color = NA
),
plot.margin = margin(0, 0, 0, 0)
)
# Place legend directly below maps
combined_final <- map_panels +
patchwork::inset_element(
legend_plot,
left = 0.13,
bottom = 0.07,
right = 0.87,
top = 0.25,
align_to = "full",
on_top = TRUE
)
print(combined_final)
ggsave(
"../data/US_CBSA_combined.png",
combined_final,
width = 14, height = 5.8,
dpi = 300, bg = "white"
)
map2
