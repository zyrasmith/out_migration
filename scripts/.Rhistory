public, size, awardlev, special_focus,
instruction_exp, pell, nonwhite,
undergrad_pop, selectivity
) |>
bind_cols(proportions |> select(C1:C7)) |>
rowwise() |>
mutate(
L1_Predicted_Class = names(pick(C1:C7))[which.max(c_across(C1:C7))],
L1_Max_Probability = max(c_across(C1:C7))
) |>
ungroup()
View(l1_test)
