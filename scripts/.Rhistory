left_join(census, by = c("cbsa" = "GEOID")) |>
mutate(cbsatype = factor(cbsatype, 0:1,
c("Micropolitan", "Metropolitan")))
# Variables
l1_vars <- c("inst_type", "system", "awardlev", "special_focus",
"num_degrees", "online_progs", "evening",
"instruction_exp_fte", "tuitionnn", "msi",
"adult", "pell", "nonwhite", "i_total_pop",
"per_undergrad", "selectivity")
l2_vars <- c("cbsatype", "total_inst", "tot_pop", "pop_density",
"perc_ba", "med_income", "perc_pov", "perc_unemployed",
"perc_white", "perc_black", "perc_hisp", "perc_asian")
l1_cat <- c("inst_type", "system", "awardlev",
"special_focus", "evening", "msi")
l2_cat <- "cbsatype"
# Descriptive statistics function
desc <- function(df, vars, cats) {
map_dfr(vars, function(v) {
if (v %in% cats) {
tibble(Category = df[[v]]) |>
filter(!is.na(Category)) |>
count(Category) |>
mutate(
Variable = paste(v, Category, sep = ": "),
`Mean (SD)` = sprintf("%.2f", n / sum(n))
) |>
select(Variable, `Mean (SD)`)
} else {
tibble(
Variable = v,
`Mean (SD)` = sprintf("%.2f (%.2f)",
mean(df[[v]], na.rm = TRUE),
sd(df[[v]], na.rm = TRUE))
)
}
})
}
# Table 1
table1 <- bind_rows(
tibble(Variable = paste0("Level 1: Institutions (N = ", nrow(l1), ")"),
`Mean (SD)` = ""),
desc(l1, l1_vars, l1_cat),
tibble(Variable = paste0("Level 2: CBSAs (N = ", nrow(l2), ")"),
`Mean (SD)` = ""),
desc(l2, l2_vars, l2_cat)
)
# Display and export
print(table1, n = Inf)
write_xlsx(table1, "../data/ashe2026/T1_HCA_descriptive_statistics.xlsx")
# Predictors
predictors <- c("tot_pop", "pop_density", "perc_ba",
"med_income", "perc_pov", "perc_unemployed",
"perc_black", "perc_hisp", "perc_asian")
# Regression data (Cluster 1 = reference)
reg_data <- d6 |>
select(cbsa_cluster, all_of(predictors)) |>
drop_na() |>
mutate(
cbsa_cluster = relevel(
factor(as.character(cbsa_cluster)), ref = "1"),
across(all_of(predictors), ~as.numeric(scale(.x)))
)
# Regression
reg_model <- nnet::multinom(
cbsa_cluster ~ .,
data = reg_data,
trace = FALSE,
Hess = TRUE,
maxit = 1000
)
if (reg_model$convergence != 0)
stop("Model did not converge.")
s <- summary(reg_model)
b <- s$coefficients
se <- s$standard.errors
# Variable labels
labels <- c(
tot_pop = "Total Population",
pop_density = "Population Density",
perc_ba = "Bachelor's Degree or Higher",
med_income = "Median Household Income",
perc_pov = "Poverty Rate",
perc_unemployed = "Unemployment Rate",
perc_black = "Non-Hispanic Black",
perc_hisp = "Hispanic or Latino",
perc_asian = "Non-Hispanic Asian",
"(Intercept)" = "Intercept"
)
# Regression results
results <- tibble(
Cluster = rep(rownames(b), each = ncol(b)),
Variable = rep(colnames(b), times = nrow(b)),
B = as.vector(t(b)),
SE = as.vector(t(se))
) |>
mutate(
p = 2 * pnorm(-abs(B / SE)),
`Est.` = paste0(
sprintf("%.2f", B),
case_when(
p < .001 ~ "***",
p < .01  ~ "**",
p < .05  ~ "*",
TRUE ~ ""
)
),
`S.E.` = sprintf("%.2f", SE),
Variable = factor(Variable,
levels = c(predictors, "(Intercept)")),
Cluster = factor(Cluster, levels = as.character(2:8))
) |>
arrange(Variable, Cluster)
# Wide format: Variables as rows, Clusters as columns
column_order <- unlist(lapply(2:8, function(k)
paste0("Cluster ", k, c(" Est.", " S.E."))
))
table7 <- results |>
select(Variable, Cluster, `Est.`, `S.E.`) |>
pivot_wider(
names_from = Cluster,
values_from = c(`Est.`, `S.E.`),
names_glue = "Cluster {Cluster} {.value}"
) |>
select(Variable, all_of(column_order)) |>
mutate(Variable = unname(labels[as.character(Variable)]))
# Full results: OR, CI, and p-values
full_results <- results |>
transmute(
Cluster = paste0("Cluster ", Cluster, " vs. Cluster 1"),
Predictor = unname(labels[as.character(Variable)]),
B = round(B, 2),
SE = round(SE, 2),
OR = round(exp(B), 2),
`95% CI` = sprintf("[%.2f, %.2f]",
exp(B - 1.96 * SE),
exp(B + 1.96 * SE)),
p = if_else(p < .001, "< .001", sprintf("%.2f", p))
)
# Model information
model_info <- tibble(
N = nrow(reg_data),
Reference = "Cluster 1",
AIC = round(AIC(reg_model), 2),
Converged = reg_model$convergence == 0
)
print(table7, width = Inf)
print(model_info)
# Export
write_xlsx(
list(
"Table 7" = table7,
"Full Results" = full_results,
"Model Information" = model_info
),
"../data/ashe2026/T7_HCA_multinomial_regression.xlsx"
)
# ASHE 2026 follow-up analyses following discussant feedback
# Run immediately AFTER the original "Multinomial logistic regression" chunk
# in analysis_ashe2026_final(4).qmd.
# The original code builds reg_data, predictors, and labels.
# It has already standardized every predictor. Do NOT standardize again here.
stopifnot(exists("reg_data"), exists("predictors"), exists("labels"))
alt_data <- reg_data |>
dplyr::mutate(
cbsa_cluster = factor(as.character(cbsa_cluster),
levels = as.character(1:8))
)
alt_predictors <- predictors
alt_labels <- labels
alt_cluster_levels <- as.character(1:8)
stopifnot(
all(stats::complete.cases(alt_data)),
all(alt_cluster_levels %in% as.character(alt_data$cbsa_cluster)),
length(unique(alt_data$cbsa_cluster)) == 8
)
# Helpers: use Wald confidence intervals (rather than refitting for profiling).
format_results <- function(tbl) {
tbl |>
dplyr::mutate(
Predictor_Label = unname(alt_labels[Predictor]),
z = B / SE,
p = 2 * stats::pnorm(-abs(z)),
OR = exp(B),
OR_CI_Lower = exp(B - 1.96 * SE),
OR_CI_Upper = exp(B + 1.96 * SE)
) |>
dplyr::select(dplyr::everything())
}
# ---------------------------------------------------------------
# 1. Multinomial logistic regression: all 8 possible reference groups
# ---------------------------------------------------------------
fit_multinom_ref <- function(ref) {
data_ref <- alt_data |>
dplyr::mutate(cbsa_cluster = stats::relevel(cbsa_cluster, ref = ref))
# Identical observations and covariates for every reference group
set.seed(321)
model <- nnet::multinom(
cbsa_cluster ~ .,
data = data_ref,
trace = FALSE,
Hess = TRUE,
maxit = 1000
)
summ <- summary(model)
b <- as.matrix(summ$coefficients)
se <- as.matrix(summ$standard.errors)
estimates <- tibble::tibble(
Reference = paste0("Cluster ", ref),
Contrast = paste0("Cluster ", rep(rownames(b), each = ncol(b)),
" vs Cluster ", ref),
Predictor = rep(colnames(b), times = nrow(b)),
B = as.vector(t(b)),
SE = as.vector(t(se))
) |>
format_results()
fit_info <- tibble::tibble(
Reference = paste0("Cluster ", ref),
N = nrow(data_ref),
AIC = stats::AIC(model),
LogLik = as.numeric(stats::logLik(model)),
Converged = model$convergence == 0
)
list(estimates = estimates, info = fit_info)
}
multinom_fits <- lapply(alt_cluster_levels, fit_multinom_ref)
alt_multinom_results <- dplyr::bind_rows(lapply(multinom_fits, `[[`, "estimates"))
alt_multinom_info <- dplyr::bind_rows(lapply(multinom_fits, `[[`, "info"))
# ---------------------------------------------------------------
# 2. Binary logistic regression: each cluster vs ALL other clusters
#    (one-vs-rest, eight distinct models)
# ---------------------------------------------------------------
fit_binary <- function(df, target, comparison) {
bdata <- df |>
dplyr::mutate(binary_target = as.integer(as.character(cbsa_cluster) == target))
model <- stats::glm(
stats::reformulate(alt_predictors, response = "binary_target"),
data = bdata,
family = stats::binomial(link = "logit"),
control = stats::glm.control(maxit = 100)
)
sm <- summary(model)$coefficients
estimates <- tibble::tibble(
Comparison = comparison,
Target = paste0("Cluster ", target),
Predictor = rownames(sm),
B = unname(sm[, "Estimate"]),
SE = unname(sm[, "Std. Error"])
) |>
format_results()
# Screening flag, not a formal test of complete or quasi separation.
possible_instability <- any(
!is.finite(stats::coef(model)) |
abs(stats::coef(model)) > 20 |
sm[, "Std. Error"] > 10,
na.rm = TRUE
)
fit_info <- tibble::tibble(
Comparison = comparison,
N = nrow(bdata),
Cases_1 = sum(bdata$binary_target == 1),
Cases_0 = sum(bdata$binary_target == 0),
AIC = stats::AIC(model),
Converged = isTRUE(model$converged),
Check_Possible_Instability = possible_instability
)
list(estimates = estimates, info = fit_info)
}
binary_ovr_fits <- lapply(alt_cluster_levels, function(k) {
fit_binary(
alt_data, target = k,
comparison = paste0("Cluster ", k, " vs Other 7 Clusters")
)
})
binary_ovr_results <- dplyr::bind_rows(lapply(binary_ovr_fits, `[[`, "estimates"))
binary_ovr_info <- dplyr::bind_rows(lapply(binary_ovr_fits, `[[`, "info"))
# ---------------------------------------------------------------
# 3. Binary logistic regression: pairwise Cluster k vs Cluster 1
#    (seven models). These are different from one-vs-rest.
# ---------------------------------------------------------------
binary_pairwise_fits <- lapply(as.character(2:8), function(k) {
pair_data <- alt_data |>
dplyr::filter(as.character(cbsa_cluster) %in% c("1", k)) |>
droplevels()
fit_binary(
pair_data, target = k,
comparison = paste0("Cluster ", k, " vs Cluster 1 (pairwise)")
)
})
binary_pairwise_results <- dplyr::bind_rows(lapply(binary_pairwise_fits, `[[`, "estimates"))
binary_pairwise_info <- dplyr::bind_rows(lapply(binary_pairwise_fits, `[[`, "info"))
# ---------------------------------------------------------------
# 4. Save separate supplementary output; original Table 7 unchanged
# ---------------------------------------------------------------
cluster_n <- alt_data |>
dplyr::count(cbsa_cluster, name = "N_CBSAs")
out_path <- "../data/ashe2026/T8_CBSA_additional_logistic_analyses.xlsx"
dir.create(dirname(out_path), showWarnings = FALSE, recursive = TRUE)
writexl::write_xlsx(
list(
Multinomial_OtherRefs = alt_multinom_results,
Multinomial_Fit = alt_multinom_info,
Binary_OneVsRest = binary_ovr_results,
Binary_OneVsRest_Fit = binary_ovr_info,
Binary_PairwiseVs1 = binary_pairwise_results,
Binary_Pairwise_Fit = binary_pairwise_info,
Sample_ByCluster = cluster_n
),
path = out_path
)
print(cluster_n)
print(alt_multinom_info)
print(binary_ovr_info)
print(binary_pairwise_info)
message("Additional analyses exported to: ", out_path)
# 1. State boundaries: 50 States + DC (exclude Puerto Rico)
us_states <- tigris::states(
cb = TRUE, year = 2024, resolution = "20m"
) |>
filter(STUSPS %in% c(state.abb, "DC"))
# 2. CBSA cluster assignments
cluster_key <- cbsa_clusters |>
transmute(
GEOID = as.character(cbsa),
cluster = paste("Cluster", cbsa_cluster)
) |>
distinct(GEOID, .keep_all = TRUE)
labels <- c("Singular Baccalaureate-Dominant Institution Areas", "Minimal Opportunity, Broad-Access Anchor Institution Areas", "Extensive-Opportunity Higher Education Ecosystems", "Singular University Hubs", "Broad Access and MSI-Opportunity Areas", "Robust Higher Education Markets", "Private College Hubs", "Two-Year and Career-Focused Opportunity Areas", "Not in sample")
# 3. CBSA boundaries and cluster data
cbsa_map <- land_area |>
sf::st_filter(
sf::st_transform(us_states, sf::st_crs(land_area))
) |>
mutate(GEOID = as.character(GEOID)) |>
left_join(cluster_key, by = "GEOID") |>
mutate(
cluster = replace_na(cluster, "Not in sample"),
cluster = factor(cluster,
levels = c(paste("Cluster", 1:8), "Not in sample"),
labels = labels)) |>
tigris::shift_geometry()
# 4. Shift Alaska and Hawaii
us_states <- us_states |>
tigris::shift_geometry()
