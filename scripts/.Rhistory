library(tidyr)
library(stringr)
vars_desc <- c(Y, Z, Zh)
desc_stats <- map_dfr(vars_desc, function(v) {
x <- data_mlca[[v]]
x_nonmiss <- x[!is.na(x)]
n_cat <- n_distinct(x_nonmiss)
# 문자/팩터 변수는 범주형으로 처리
if (is.character(x_nonmiss) || is.factor(x_nonmiss)) {
cats <- sort(unique(as.character(x_nonmiss)))
tibble(
variable = v,
category = cats,
mean = map_dbl(cats, ~ mean(as.character(x_nonmiss) == .x)),
sd = NA_real_,
type = "categorical_3plus"
)
} else if (n_cat == 2) {
# 이분형 변수: mean만 제시
tibble(
variable = v,
category = NA_character_,
mean = mean(x_nonmiss, na.rm = TRUE),
sd = NA_real_,
type = "binary"
)
} else if (n_cat >= 3 && all(x_nonmiss %% 1 == 0)) {
cats <- sort(unique(x_nonmiss))
tibble(
variable = v,
category = as.character(cats),
mean = map_dbl(cats, ~ mean(x_nonmiss == .x)),
sd = NA_real_,
type = "categorical_3plus"
)
} else {
tibble(
variable = v,
category = NA_character_,
mean = mean(x_nonmiss, na.rm = TRUE),
sd = sd(x_nonmiss, na.rm = TRUE),
type = "continuous"
)
}
})
desc_table <- desc_stats %>%
mutate(
variable_label = if_else(
is.na(category),
variable,
paste0(variable, " = ", category)
),
mean = round(mean, 3),
sd = round(sd, 3)
) %>%
select(variable, variable_label, mean, sd, type)
desc_table
library(dplyr)
library(purrr)
library(tidyr)
library(stringr)
vars_desc <- c(Y, Z, Zh)
desc_stats <- map_dfr(vars_desc, function(v) {
x <- data_mlca[[v]]
x_nonmiss <- x[!is.na(x)]
n_cat <- n_distinct(x_nonmiss)
# make categorical variables
if (is.character(x_nonmiss) || is.factor(x_nonmiss)) {
cats <- sort(unique(as.character(x_nonmiss)))
tibble(
variable = v,
category = cats,
mean = map_dbl(cats, ~ mean(as.character(x_nonmiss) == .x)),
sd = NA_real_,
type = "categorical_3plus"
)
} else if (n_cat == 2) {
# binary variables
tibble(
variable = v,
category = NA_character_,
mean = mean(x_nonmiss, na.rm = TRUE),
sd = NA_real_,
type = "binary"
)
} else if (n_cat >= 3 && all(x_nonmiss %% 1 == 0)) {
# categorical variables with 3 or more categories
cats <- sort(unique(x_nonmiss))
tibble(
variable = v,
category = as.character(cats),
mean = map_dbl(cats, ~ mean(x_nonmiss == .x)),
sd = NA_real_,
type = "categorical_3plus"
)
} else {
# continous variables: mean, sd
tibble(
variable = v,
category = NA_character_,
mean = mean(x_nonmiss, na.rm = TRUE),
sd = sd(x_nonmiss, na.rm = TRUE),
type = "continuous"
)
}
})
# organize
desc_table <- desc_stats %>%
mutate(
variable_label = if_else(
is.na(category),
variable,
paste0(variable, " = ", category)
),
mean = round(mean, 3),
sd = round(sd, 3)
) %>%
select(variable, variable_label, mean, sd, type)
desc_table
library(dplyr)
library(purrr)
library(tibble)
# 분석에 사용한 변수만
vars_used <- c(Y, Z, Zh)
# 정수형이어도 연속형으로 볼 변수
continuous_vars <- c(
"i_perc_white", "i_perc_black", "i_perc_hisp", "i_perc_asian",
"inst_num", "tot_pop", "pop_density", "perc_ba", "med_income",
"perc_pov", "perc_unemployed", "perc_white", "perc_black",
"perc_hisp", "perc_asian"
)
desc_table <- map_dfr(vars_used, function(v) {
x <- data_mlca[[v]]
x_nonmiss <- x[!is.na(x)]
n_cat <- dplyr::n_distinct(x_nonmiss)
if (v %in% continuous_vars) {
tibble(
variable = v,
category = NA_character_,
mean = mean(x_nonmiss, na.rm = TRUE),
sd = sd(x_nonmiss, na.rm = TRUE)
)
} else if (is.character(x_nonmiss) || is.factor(x_nonmiss)) {
cats <- sort(unique(as.character(x_nonmiss)))
tibble(
variable = v,
category = cats,
mean = map_dbl(cats, ~ mean(as.character(x_nonmiss) == .x)),
sd = NA_real_
)
} else if (n_cat == 2) {
tibble(
variable = v,
category = NA_character_,
mean = mean(x_nonmiss, na.rm = TRUE),
sd = NA_real_
)
} else {
cats <- sort(unique(x_nonmiss))
tibble(
variable = v,
category = as.character(cats),
mean = map_dbl(cats, ~ mean(x_nonmiss == as.numeric(.x))),
sd = NA_real_
)
}
})
desc_table <- desc_table %>%
mutate(
variable_label = if_else(
is.na(category),
variable,
paste0(variable, " = ", category)
),
mean = round(mean, 3),
sd = round(sd, 3),
stat = if_else(
is.na(sd),
sprintf("%.3f", mean),
sprintf("%.3f (%.3f)", mean, sd)
)
) %>%
select(variable, variable_label, mean, sd, stat)
desc_table
library(dplyr)
library(purrr)
library(tibble)
# Use only variables included in the analysis
vars_used <- c(Y, Z, Zh)
# Treat these variables as continuous even if some are stored as integers
continuous_vars <- c(
"i_perc_white", "i_perc_black", "i_perc_hisp", "i_perc_asian",
"inst_num", "tot_pop", "pop_density", "perc_ba", "med_income",
"perc_pov", "perc_unemployed", "perc_white", "perc_black",
"perc_hisp", "perc_asian"
)
desc_table <- map_dfr(vars_used, function(v) {
x <- data_mlca[[v]]
x_nonmiss <- x[!is.na(x)]
n_cat <- dplyr::n_distinct(x_nonmiss)
if (v %in% continuous_vars) {
# For continuous variables, report mean and standard deviation
tibble(
variable = v,
category = NA_character_,
mean = round(mean(x_nonmiss, na.rm = TRUE), 3),
sd = round(sd(x_nonmiss, na.rm = TRUE), 3)
)
} else if (is.character(x_nonmiss) || is.factor(x_nonmiss)) {
# For categorical string/factor variables with 3+ categories,
# report the proportion for each category
cats <- sort(unique(as.character(x_nonmiss)))
tibble(
variable = v,
category = cats,
mean = map_dbl(cats, ~ round(mean(as.character(x_nonmiss) == .x), 3)),
sd = NA_real_
)
} else if (n_cat == 2) {
# For binary variables, report only the mean
tibble(
variable = v,
category = NA_character_,
mean = round(mean(x_nonmiss, na.rm = TRUE), 3),
sd = NA_real_
)
} else {
# For numeric variables with 3+ categories, report the proportion for each category
cats <- sort(unique(x_nonmiss))
tibble(
variable = v,
category = as.character(cats),
mean = map_dbl(cats, ~ round(mean(x_nonmiss == as.numeric(.x)), 3)),
sd = NA_real_
)
}
})
desc_table <- desc_table %>%
mutate(
variable_label = if_else(
is.na(category),
variable,
paste0(variable, " = ", category)
),
stat = if_else(
is.na(sd),
sprintf("%.3f", mean),
sprintf("%.3f (%.3f)", mean, sd)
)
) %>%
select(variable, variable_label, mean, sd, stat)
desc_table
