cluster_colors <-  c(
"Singular Baccalaureate-Dominant Institution Areas" = "#CC6677",
"Minimal Opportunity, Broad-Access Anchor Institution Areas" = "#332288",
"Extensive-Opportunity Higher Education Ecosystems" = "#DDCC77",
"Singular University Hubs" = "#117733",
"Broad Access and MSI-Opportunity Areas" = "#88CCEE",
"Robust Higher Education Markets" = "#AA4499",
