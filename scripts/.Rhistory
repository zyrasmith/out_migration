cats <- sort(unique(as.character(x_nonmiss)))
tibble(
variable = v,
category = cats,
mean = map_dbl(cats, ~ round(mean(as.character(x_nonmiss) == .x), 2)),
sd = NA_real_
)
} else if (n_cat == 2) {
# For binary variables, report only the mean
tibble(
variable = v,
category = NA_character_,
mean = round(mean(x_nonmiss, na.rm = TRUE), 2),
sd = NA_real_
)
} else {
# For numeric variables with 3+ categories, report the proportion for each category
cats <- sort(unique(x_nonmiss))
tibble(
variable = v,
category = as.character(cats),
mean = map_dbl(cats, ~ round(mean(x_nonmiss == as.numeric(.x)), 2)),
sd = NA_real_
)
}
})
