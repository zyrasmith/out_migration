install.packages("NbClust")
library(NbClust)
fviz_nbclust(analytic, hcut, method = c("silhouette", "wss", "gap_stat"))
fviz_nbclust(analytic, hcut, method = c("silhouette"))
fviz_nbclust(analytic, hcut, method = "silhouette")
fviz_nbclust(res.agnes, hcut, method = "silhouette")
fviz_nbclust(analytic, hcut, method = "silhouette")
